# Copy to wrangler.toml and fill in the D1 database_id.
#   cp wrangler.toml.example wrangler.toml
# Keep the real wrangler.toml out of public repos if you put secrets in it
# (use `wrangler secret put` / dashboard variables for secrets instead).

name = "coverkit"
main = "worker.js"
compatibility_date = "2026-01-01"

# The repo root is the static site; .assetsignore keeps the Worker modules,
# schema and docs from being served as public files.
[assets]
directory = "."
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "coverkit"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# Non-secret settings can live here; secrets should use `wrangler secret put`.
# [vars]
# ACCESS_TEAM = "your-team"        # <team>.cloudflareaccess.com, for /admin
# ACCESS_AUD  = "your-access-app-aud"
# Secrets (dashboard or `wrangler secret put NAME`):
#   TURNSTILE_SECRET  - optional, pairs with TURNSTILE_SITEKEY in app.js
#   IP_SALT           - optional, extra salt for hashed IPs
